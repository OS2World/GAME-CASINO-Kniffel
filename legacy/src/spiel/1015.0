/* Event auf ~6 CMD_SECHS, Clicked/selected */
Arg window self

/* die "Zul„ssigkeitsprfungen" sind im Grunde ber-
   flssig, da durch Button-disable/enable reali-
   siert - rein sicherheitshalber dringelassen */
   
/* prfe, ob schon gewrfelt: */
if anz_wurf = 0 then return

if anz_wurf > 3 then return

if wert_lst.spl_nr.6 \= '' then return
  
/* nutzt global stem-var wurf.?.wert - besetzt aus */
/* routine werfen                                  */

/* prft auf min 3 * 6 - setzt gef * 6 - 0 ist */
/* vorbesetzt - callt schluáendlich Setz/Runden- */
/* routine */

gef=0

do i = 1 to 5
  if wurf.i.wert=6 then
    gef=gef+1

end /* end do */

if gef>2 then
  gef=gef * 6
else
  gef=0
/* endif */

/* Disable item CMD_SECHS Push Button */
CALL VpItem window,'CMD_SECHS','DISABLE'
/* Hide item BMP_SECHS_CMD Graphic */
CALL VpItem window,'BMP_SECHS_CMD','HIDE'

call setzen '6', gef
 

