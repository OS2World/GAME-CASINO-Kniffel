/* Event auf ~3 CMD_DREI, Clicked/selected */
Arg window self

/* die "Zul„ssigkeitsprfungen" sind im Grunde ber-
   flssig, da durch Button-disable/enable reali-
   siert - rein sicherheitshalber dringelassen */
   
/* prfe, ob schon gewrfelt: */
if anz_wurf = 0 then return

if anz_wurf > 3 then return

if wert_lst.spl_nr.3 \= '' then return
  
/* nutzt global stem-var wurf.?.wert - besetzt aus */
/* routine werfen                                  */

/* prft auf min 3 * 3 - setzt gef * 3 - 0 ist */
/* vorbesetzt - callt schluáendlich Setz/Runden- */
/* routine */

gef=0

do i = 1 to 5
  if wurf.i.wert=3 then
    gef=gef+1

end /* end do */

if gef>2 then
  gef=gef * 3
else
  gef=0
/* endif */

/* Disable item CMD_DREI Push Button */
CALL VpItem window,'CMD_DREI','DISABLE'
/* Hide item BMP_DREI_CMD Graphic */
CALL VpItem window,'BMP_DREI_CMD','HIDE'

call setzen '3', gef
 

