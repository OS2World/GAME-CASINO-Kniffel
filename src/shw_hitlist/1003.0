/* Event Bestenliste ~l”schen CMD_LOESCHEN, Clicked/selected */
Arg window self

/* REXXUTIL ist geladen ... */

rc = sysfiledelete(pfad_name||'hitlist.hgh')

/* Disable item CMD_LOESCHEN Push Button */
