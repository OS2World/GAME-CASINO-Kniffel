CALL VpItem window,'BMP_LIST_CMD','HIDE'
/* Hide item BMP_ENDE_CMD Graphic */
CALL VpItem window,'BMP_ENDE_CMD','HIDE'
/* Hide item BMP_BOOK_CMD Graphic */
CALL VpItem window,'BMP_BOOK_CMD','HIDE'

